{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RiverLub Desktop",
  "version": "0.3.0",
  "identifier": "br.com.riverlub.connect",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RiverLub Desktop",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:47851 http://localhost:47851 http://127.0.0.1:47852 http://localhost:47852"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "RiverLub",
    "category": "Business",
    "shortDescription": "RiverLub Desktop para integracoes locais",
    "longDescription": "Aplicativo desktop local para WhatsApp Connect, RiverLub Brain e modulos internos seguros no Windows.",
    "resources": {
      "../vendor/node/node.exe": "runtime/node/node.exe",
      "../../backend/whatsapp-agent/src": "runtime/whatsapp-agent/src",
      "../../backend/whatsapp-agent/package.json": "runtime/whatsapp-agent/package.json",
      "../../backend/whatsapp-agent/package-lock.json": "runtime/whatsapp-agent/package-lock.json",
      "../../backend/whatsapp-agent/node_modules": "runtime/whatsapp-agent/node_modules"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "RiverLub",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
